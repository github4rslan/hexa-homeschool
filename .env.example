# MongoDB (system of record)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hexa?retryWrites=true&w=majority
MONGODB_DB=hexa

# Auth (sign a long random string — used for JWT session cookies)
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# Admin seed (staff access). Used ONLY by `npm run seed:admin` to create/promote
# one admin account — a normal parent with role:"admin". There is no separate
# admin auth; after seeding, sign in at /login and you land on /admin.
# Set these locally in .env.local (never commit real values) or in Vercel.
# Password must be >= 12 chars. Re-running resets the password + re-grants admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OpenAI (Teaching Agent + Checker)
OPENAI_API_KEY=
# AI-generated lesson visuals are opt-in. Set true to enable the Visual Agent;
# unset/false = lessons show no AI visuals.
AI_VISUALS_ENABLED=false

# ElevenLabs (lesson narration / TTS + spoken-answer transcription / STT)
ELEVENLABS_API_KEY=

# Cloudinary (media: marketing images, lesson audio, work uploads, portfolio PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo) — signup verification + portfolio sharing.
# If unset, signups auto-verify (no lockout) and email features no-op.
# Brevo free tier delivers to any recipient once a sender/domain is verified.
# EMAIL_FROM must use a sender/domain you've verified in Brevo, else sends fail.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=Edway <your-verified-sender@example.com>

# Stripe (subscription billing) — unset = billing routes degrade gracefully
# (checkout/portal redirect with a friendly message, webhook returns 503).
# Prices are recurring GBP prices created in the Stripe dashboard:
#   STRIPE_PRICE_STANDARD → Edway Complete £49/mo (tier "standard")
#   STRIPE_PRICE_FAMILY   → Edway Partner  £99/mo (tier "family")
# STRIPE_WEBHOOK_SECRET is the signing secret of a webhook endpoint pointed at
# /api/billing/webhook with events: checkout.session.completed,
# customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_FAMILY=

# PostHog product analytics (PARENTS ONLY — never loaded in (child) routes).
# Unset = no-op (no script loads, no events). EU cloud host by default for
# UK/EU data residency. Identifies parents by Mongo id only — never PII.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog read access for the daily Slack stats digest (/api/digest/daily-stats)
# only — a personal API key with project query-read scope, distinct from the
# public write-only key above. Unset = the digest's traffic line reports
# "not configured yet" instead of failing the rest of the digest.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Twilio (immediate-severity safety SMS to parents) — all three required to
# send; unset = silent skip (email + dashboard escalation remain the baseline).
# TWILIO_FROM is your Twilio phone number / messaging-service sender in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web Push (parent-only milestone notifications) — all three required; unset =
# feature fully off (subscribe control hides, no push sent). Generate a VAPID
# keypair once with `npx web-push generate-vapid-keys`. WEB_PUSH_SUBJECT is a
# contact URL for push services, e.g. "mailto:you@example.com". The public key
# is served to the browser via /api/push/public-key (it is not a secret).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Upstash Redis (distributed rate limiting) — unset = per-instance in-memory
# fallback (still rate-limited, just not shared across Vercel instances).
# Create a free Redis database at https://console.upstash.com and copy the
# REST URL + token from its "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron (weekly parent digest + daily lifecycle emails) — Vercel sends
# `Authorization: Bearer $CRON_SECRET` to /api/digest/weekly and
# /api/lifecycle/daily automatically when this is set. Unset = both disabled.
CRON_SECRET=replace-with-a-long-random-string

# Sentry error tracking — unset = completely disabled (no-op init).
# NEXT_PUBLIC_ so the browser bundle gets it too; a DSN is not a secret.
# PII capture is disabled in code (children's platform): events carry stack
# traces and route names only — never identities, bodies, cookies or replay.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Slack alerts (optional, out-of-band alert channel for the integration
# health monitor at /api/monitor/integrations). Unset = the Slack post is
# silently skipped, same graceful-degradation pattern as every other optional
# integration above; Sentry capture still happens either way. Create an
# "Incoming Webhook" in Slack and paste its URL here.
SLACK_ALERTS_WEBHOOK_URL=

# Slack growth pings (optional, real-time notification on a genuine signup or
# subscription — see lib/analytics/growth-alert.ts). Deliberately a separate
# webhook/channel from SLACK_ALERTS_WEBHOOK_URL so business signal never gets
# buried in, or dilutes, incident noise. Unset = silently skipped.
SLACK_GROWTH_WEBHOOK_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Edway

# Post-deploy smoke tests (Playwright). The dedicated smoke account's
# credentials — set by the owner via `npm run smoke:setup`, then stored as
# GitHub Actions secrets so the CI smoke job can log in. Unset = the login-gated
# smoke tests skip cleanly (forks, PRs). SMOKE_BASE_URL overrides the target
# (defaults to NEXT_PUBLIC_APP_URL / the production domain).
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_BASE_URL=
