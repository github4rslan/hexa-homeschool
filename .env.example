# MongoDB (system of record)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hexa?retryWrites=true&w=majority
MONGODB_DB=hexa

# Auth (sign a long random string — used for JWT session cookies)
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# OpenAI (Teaching Agent + Checker)
OPENAI_API_KEY=

# ElevenLabs (lesson narration / TTS)
ELEVENLABS_API_KEY=

# Cloudinary (media: marketing images, lesson audio, work uploads, portfolio PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo) — signup verification + portfolio sharing.
# If unset, signups auto-verify (no lockout) and email features no-op.
# Brevo free tier delivers to any recipient once a sender/domain is verified.
# EMAIL_FROM must use a sender/domain you've verified in Brevo, else sends fail.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=HEXA <your-verified-sender@example.com>

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HEXA
