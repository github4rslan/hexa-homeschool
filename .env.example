# MongoDB (system of record)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hexa?retryWrites=true&w=majority
MONGODB_DB=hexa

# Auth (sign a long random string — used for JWT session cookies)
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# OpenAI (Teaching Agent + Checker)
OPENAI_API_KEY=

# ElevenLabs (lesson narration / TTS + spoken-answer transcription / STT)
ELEVENLABS_API_KEY=

# Cloudinary (media: marketing images, lesson audio, work uploads, portfolio PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo) — signup verification + portfolio sharing.
# If unset, signups auto-verify (no lockout) and email features no-op.
# Brevo free tier delivers to any recipient once a sender/domain is verified.
# EMAIL_FROM must use a sender/domain you've verified in Brevo, else sends fail.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=HEXA <your-verified-sender@example.com>

# Stripe (subscription billing) — unset = billing routes degrade gracefully
# (checkout/portal redirect with a friendly message, webhook returns 503).
# Prices are recurring GBP prices created in the Stripe dashboard:
#   STRIPE_PRICE_STANDARD → HEXA Complete £49/mo (tier "standard")
#   STRIPE_PRICE_FAMILY   → HEXA Partner  £99/mo (tier "family")
# STRIPE_WEBHOOK_SECRET is the signing secret of a webhook endpoint pointed at
# /api/billing/webhook with events: checkout.session.completed,
# customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_FAMILY=

# Cron (weekly parent digest) — Vercel sends `Authorization: Bearer $CRON_SECRET`
# to /api/digest/weekly automatically when this is set. Unset = digest disabled.
CRON_SECRET=replace-with-a-long-random-string

# Sentry error tracking — unset = completely disabled (no-op init).
# NEXT_PUBLIC_ so the browser bundle gets it too; a DSN is not a secret.
# PII capture is disabled in code (children's platform): events carry stack
# traces and route names only — never identities, bodies, cookies or replay.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HEXA
